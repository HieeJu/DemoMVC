@model IEnumerable<DemoMVC.Models.Student>

<h2>Quản Lý Sinh Viên</h2>
<div id="crudMessage" class="alert d-none" role="status"></div>

<p>
    <!-- Nút kích hoạt mở Modal Thêm mới -->
    <button type="button" class="btn btn-primary" id="btnCreate" data-url="@Url.Action("Create")">
        Thêm Mới (Ajax)
    </button>
</p>

<table class="table table-striped table-bordered" id="studentTable"
       data-rows-url="@Url.Action("Rows")">
    <thead>
        <tr>
            <th>Mã SV</th>
            <th>Họ Tên</th>
            <th>Khoa</th>
            <th>Địa Chỉ</th>
            <th>Email</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        <partial name="_Rows" model="Model" />
    </tbody>
</table>

<!-- ================= BOOTSTRAP MODAL CHUNG ================= -->
<div class="modal fade" id="genericModal" tabindex="-1" role="dialog" aria-labelledby="genericModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="modalContent">
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/crud-modal.js"></script>
}