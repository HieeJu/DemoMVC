@model IEnumerable<DemoMVC.Models.Student>

<h2>Danh sách học sinh</h2>

@if (TempData["Data"] != null)
{
    <h3 style="color: green;">@TempData["Data"]</h3>
}

<table class="table">
    <thead>
        <tr>
            <th>Họ và tên</th>
            <th>Địa chỉ</th>
            <th>Trường đại học</th>
            <th>Email</th> 
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.FullName</td>
            <td>@item.Address</td>
            <td>@item.University</td>
            <td>@item.Email</td> 
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>