@model DemoMVC.Models.Student

<h2>Nhập Sinh Viên Mới (Mã tự động sinh)</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="FullName" class="control-label"></label>
        <input asp-for="FullName" class="form-control" placeholder="Nhập Họ và Tên" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="FacultyId" class="control-label"></label>
        <select asp-for="FacultyId" class="form-control" asp-items="ViewBag.FacultyId">
            <option value="">-- Chọn Khoa thuộc HUMG --</option>
        </select>
        <span asp-validation-for="FacultyId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Address" class="control-label"></label>
        <input asp-for="Address" class="form-control" placeholder="Nhập Địa chỉ" />
    </div>

    <div class="form-group mb-3">
        <label asp-for="Email" class="control-label"></label>
        <input asp-for="Email" class="form-control" placeholder="Nhập Email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Lưu Sinh Viên" class="btn btn-success" />
        <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}