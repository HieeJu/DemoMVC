@model DemoMVC.Models.Student
@{
    var isEdit = !string.IsNullOrEmpty(Model.StudentId);
}
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.StudentId" method="post">
    @if (isEdit)
    {
        <input type="hidden" asp-for="StudentId" />
    }
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Sửa sinh viên" : "Thêm sinh viên")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        @if (isEdit)
        {
            <div class="mb-3">
                <label asp-for="StudentId" class="form-label"></label>
                <input asp-for="StudentId" class="form-control" disabled />
            </div>
        }
        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FacultyId" class="form-label"></label>
            <select asp-for="FacultyId" class="form-select" asp-items="ViewBag.FacultyId">
                <option value="">-- Chọn khoa --</option>
            </select>
            <span asp-validation-for="FacultyId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        @Html.AntiForgeryToken()
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>
