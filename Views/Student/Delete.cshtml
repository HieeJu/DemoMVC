@model DemoMVC.Models.Student

<h2>Xác nhận xóa học sinh</h2>

<h3>Bạn có chắc chắn muốn xóa học sinh này không?</h3>
<div>
    <dl class="row">
        <dt class="col-sm-3">Họ và tên:</dt>
        <dd class="col-sm-9">@Model.FullName</dd>

        <dt class="col-sm-3">Địa chỉ:</dt>
        <dd class="col-sm-9">@Model.Address</dd>

        <dt class="col-sm-3">Trường đại học:</dt>
        <dd class="col-sm-9">@Model.University</dd>

        <dt class="col-sm-3">Email:</dt>
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>
    
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa thực sự" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
    </form>
</div>