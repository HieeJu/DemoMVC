@model DemoMVC.Models.RoleEditViewModel
<form asp-action="@(string.IsNullOrEmpty(Model.Id) ? "Create" : "Edit")" method="post">
    <div class="modal-header">
        <h5 class="modal-title">@(string.IsNullOrEmpty(Model.Id) ? "Tạo Role" : "Sửa Role")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="Id" type="hidden" />
        <label asp-for="Name" class="form-label">Tên Role</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
        @Html.AntiForgeryToken()
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>
