@model IEnumerable<DemoMVC.Models.ApplicationRole>
@{
    ViewData["Title"] = "Quản lý Role";
}
<h1>Quản lý Role</h1>
<div id="crudMessage" class="alert d-none" role="status"></div>
<p><button type="button" class="btn btn-primary" id="btnCreate" data-url="@Url.Action("Create")">Thêm Role</button></p>
<table class="table table-striped" id="roleTable" data-rows-url="@Url.Action("Rows")">
    <thead><tr><th>Tên Role</th><th>Loại</th><th>Thao tác</th></tr></thead>
    <tbody><partial name="_Rows" model="Model" /></tbody>
</table>
<div class="modal fade" id="genericModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content" id="modalContent"></div></div>
</div>
@section Scripts {
    <script src="~/js/crud-modal.js"></script>
}
